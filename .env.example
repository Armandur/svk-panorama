# Kopiera till .env och fyll i. Aldrig hemligheter i repo.

# Signeringsnyckel för CSRF- OCH session-cookies. Sätt en fast i produktion
# (annars roteras den per omstart och alla inloggningar invalideras).
SVK_SECRET_KEY=byt-mig-till-en-lang-slumpstrang

# Bootstrap-admin: skapas vid FÖRSTA uppstarten om inga användare finns (sluten
# inbjudan - admin bjuder sedan in övriga). Krävs för att kunna logga in alls.
SVK_ADMIN_EMAIL=du@exempel.se
SVK_ADMIN_PASSWORD=byt-mig

# Lyssnande port (mappas till en host-port i drift).
SVK_PORT=8002

# Persistent data. Lokalt: relativt repo-roten. I container: absoluta paths, och
# för tiling via docker.sock måste de vara IDENTISKA på värd och container -
# se DOCKER.md. Imagens default: /data/projects + /data/svk.db.
SVK_PROJECTS_DIR=projects
# SVK_DB_FILE=svk.db

# Tiling-parallellitet (nona är enkeltrådat; håll lågt på delad värd).
SVK_TILE_CONCURRENCY=2

# Publik bas-URL (för framtida export/delningslänkar). Tom = relativa vägar.
# SVK_BASE_URL=https://turer.exempel.se

# Uppladdningsgränser / preview (default oftast bra).
# SVK_MAX_PANORAMA_MB=80
# SVK_MAX_MAP_MB=20
# SVK_PREVIEW_MAX_WIDTH=2048
# SVK_PREVIEW_QUALITY=82
